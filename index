<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách bài tập Web</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
        }
        
        /* Phần thanh tiêu đề màu đen */
        .header {
            background-color: #222222;
            color: #ffffff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
            font-size: 17px;
            font-weight: 500;
        }
        
        .header .icon {
            cursor: pointer;
            font-size: 20px;
        }

        /* Phần nội dung chính */
        .content {
            padding: 20px;
        }

        .content h3 {
            margin-top: 10px;
            margin-bottom: 25px;
            font-size: 16px;
            color: #333333;
        }

        /* Danh sách các thẻ link */
        .link-list {
            display: flex;
            flex-direction: column;
            gap: 12px; 
        }

        .link-list a {
            color: #0066cc;
            text-decoration: none;
            font-size: 15px;
        }

        /* Hiệu ứng khi di chuột qua link (dành cho máy tính) */
        .link-list a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <!-- Thanh tiêu đề -->
    <div class="header">
        <span class="icon">&lt;</span>
        <span>Danh sách bài tập Web</span>
        <span class="icon">...</span>
    </div>

    <!-- Nội dung danh sách -->
    <div class="content">
        <h3>Danh Sách Bài Tập Thiết Kế Web</h3>
        
        <div class="link-list">
            <!-- Thay đổi đường dẫn trong phần href="" -->
            <a href="link_cua_ban_o_day">Bài 1</a>
            <a href="link_cua_ban_o_day">Bài 2</a>
            <a href="link_cua_ban_o_day">Bài 3</a>
            <a href="link_cua_ban_o_day">Bài 4</a>
            <a href="link_cua_ban_o_day">Bài 5</a>
            <a href="link_cua_ban_o_day">Bài 6</a>
            <a href="link_cua_ban_o_day">Bài 7</a>
        </div>
    </div>

</body>
</html>
